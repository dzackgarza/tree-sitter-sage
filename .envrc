source "$HOME/.envrc"

# The QC profile runs the suite under Sage's own interpreter, so the
# tests that prove lowered output builds real Sage objects actually run.
# That proof rides on this binding, so it is validated where it is
# created: an empty or non-Sage value would swap the interpreter the
# suite claims to run under, and direnv must refuse to load an
# environment rather than export a weakened one (a nonzero exit here
# makes direnv error out and export nothing).
SAGE_BIN="${SAGE_BIN:-$(command -v sage || true)}"
if [ -z "$SAGE_BIN" ]; then
  echo "ERROR: no Sage driver: SAGE_BIN is unset and no 'sage' is on PATH." >&2
  exit 1
fi
if [ ! -x "$SAGE_BIN" ]; then
  echo "ERROR: SAGE_BIN is not an executable: $SAGE_BIN" >&2
  exit 1
fi
# `--version` on the driver script is ~0.1s; capture instead of piping
# to grep so a SIGPIPE cannot fail a matching pipeline under pipefail.
sage_version="$("$SAGE_BIN" --version 2>/dev/null || true)"
case "$sage_version" in
  "SageMath version "*) ;;
  *)
    echo "ERROR: SAGE_BIN does not identify as SageMath: $SAGE_BIN (--version said: '$sage_version')" >&2
    exit 1
    ;;
esac
unset sage_version
export SAGE_BIN

# mypy runs on changed-file batches; the editable install is an import
# hook mypy cannot traverse, so resolve sageparse from source.
export MYPYPATH=src

# Only claim the diff base where the ref exists (CI checkouts provision
# their own base).
if [ -z "${DIFF_COVER_BASE:-}" ]; then
  if git rev-parse --verify --quiet main >/dev/null; then
    export DIFF_COVER_BASE=main
  elif git rev-parse --verify --quiet origin/main >/dev/null; then
    export DIFF_COVER_BASE=origin/main
  fi
fi
