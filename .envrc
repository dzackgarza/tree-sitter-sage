source "$HOME/.envrc"

# mypy runs on changed-file batches; the editable install is an import
# hook mypy cannot traverse, so resolve sagepython from source.
export MYPYPATH=src

# This fork keeps upstream's default branch name; only claim it where
# the ref exists (CI checkouts provision their own base).
if [ -z "${DIFF_COVER_BASE:-}" ]; then
  if git rev-parse --verify --quiet master >/dev/null; then
    export DIFF_COVER_BASE=master
  elif git rev-parse --verify --quiet origin/master >/dev/null; then
    export DIFF_COVER_BASE=origin/master
  fi
fi
