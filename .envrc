source "$HOME/.envrc"

# The QC profile runs the suite under Sage's own interpreter, so the
# tests that prove lowered output builds real Sage objects actually run.
export SAGE_BIN="${SAGE_BIN:-$(command -v sage)}"

# mypy runs on changed-file batches; the editable install is an import
# hook mypy cannot traverse, so resolve sageparse from source.
export MYPYPATH=src

# Only claim the diff base where the ref exists (CI checkouts provision
# their own base).
if [ -z "${DIFF_COVER_BASE:-}" ]; then
  if git rev-parse --verify --quiet main >/dev/null; then
    export DIFF_COVER_BASE=main
  elif git rev-parse --verify --quiet origin/main >/dev/null; then
    export DIFF_COVER_BASE=origin/main
  fi
fi
